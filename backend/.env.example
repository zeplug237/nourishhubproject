NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5500
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
DATABASE_URL="postgresql://nourish_app:your-password@127.0.0.1:5432/nourish_hub?schema=public"
STORE_TIMEZONE=Africa/Douala
CURRENCY=XAF
SEED_ADMIN_EMAIL=admin@nourishhub.cm
SEED_ADMIN_PASSWORD=replace-with-a-private-random-password

# Resend transactional email settings. Use a verified sender domain.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM="NOURISH HUB <verification@your-verified-domain.com>"
# Local-only fallback: codes are printed in the backend terminal. Never enable in production.
EMAIL_DEV_MODE=false
