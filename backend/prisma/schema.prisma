generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STOREKEEPER
  CASHIER
  ACCOUNTANT
  AUDIT_TEAM_LEAD
  INVENTORY_OFFICER
}
enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}
enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}
enum MovementType {
  OPENING
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  VOID_REVERSAL
}
enum NotificationType {
  NEW_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  SYSTEM
}
enum NotificationPriority {
  INFO
  WARNING
  CRITICAL
}

model User {
  id             BigInt    @id @default(autoincrement()) @db.BigInt
  full_name      String    @db.VarChar(140)
  email          String    @unique @db.VarChar(190)
  password_hash  String    @db.VarChar(255)
  role           UserRole  @default(CASHIER)
  is_active      Boolean   @default(true)
  email_verified Boolean   @default(false)
  verification_code_hash String? @db.VarChar(64)
  verification_expires_at DateTime? @db.Timestamp(0)
  verification_attempts Int @default(0)
  last_login_at  DateTime? @db.Timestamp(0)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  stock_entries  StockEntry[]
  sales          Sale[]
  stock_movements StockMovement[]
  notifications  Notification[]
  audit_logs     AuditLog[]
  @@map("users")
}

model Category {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  products    Product[]
  @@map("categories")
}

model Supplier {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  name           String       @db.VarChar(150)
  contact_person String?      @db.VarChar(140)
  phone          String?      @db.VarChar(40)
  email          String?      @db.VarChar(190)
  address        String?      @db.VarChar(255)
  notes          String?      @db.Text
  created_at     DateTime?    @default(now()) @db.Timestamp(0)
  products       Product[]
  stock_entries  StockEntry[]
  @@index([name], map: "idx_supplier_name")
  @@map("suppliers")
}

model Product {
  id                   BigInt          @id @default(autoincrement()) @db.BigInt
  sku                  String          @unique @db.VarChar(70)
  name                 String          @db.VarChar(160)
  category_id          BigInt?         @db.BigInt
  description          String?         @db.Text
  unit                 String          @default("unit") @db.VarChar(30)
  purchase_price       Decimal         @default(0) @db.Decimal(14, 2)
  selling_price        Decimal         @default(0) @db.Decimal(14, 2)
  stock_quantity       Int             @default(0)
  low_stock_threshold  Int             @default(10)
  supplier_id          BigInt?         @db.BigInt
  is_active            Boolean         @default(true)
  created_at           DateTime?       @default(now()) @db.Timestamp(0)
  updated_at           DateTime?       @db.Timestamp(0)
  category             Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  supplier             Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  stock_entries        StockEntry[]
  sale_items           SaleItem[]
  stock_movements      StockMovement[]
  notifications        Notification[]
  @@index([name], map: "idx_product_name")
  @@index([stock_quantity], map: "idx_product_stock")
  @@map("products")
}

model StockEntry {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  receipt_no        String    @unique @db.VarChar(40)
  product_id        BigInt    @db.BigInt
  supplier_id       BigInt?   @db.BigInt
  quantity_received Int
  previous_quantity Int
  new_quantity      Int
  unit_cost         Decimal   @default(0) @db.Decimal(14, 2)
  arrival_date      DateTime  @db.Date
  recorded_by       BigInt    @db.BigInt
  recorded_at       DateTime  @default(now()) @db.Timestamp(0)
  notes             String?   @db.Text
  product           Product   @relation(fields: [product_id], references: [id])
  supplier          Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  recorder          User      @relation(fields: [recorded_by], references: [id])
  @@index([recorded_at], map: "idx_receipt_date")
  @@map("stock_entries")
}

model Sale {
  id             BigInt           @id @default(autoincrement()) @db.BigInt
  sale_no        String        @unique @db.VarChar(40)
  cashier_id     BigInt           @db.BigInt
  subtotal       Decimal       @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  total_amount   Decimal       @db.Decimal(14, 2)
  payment_method PaymentMethod @default(CASH)
  amount_paid    Decimal       @db.Decimal(14, 2)
  change_due     Decimal       @default(0) @db.Decimal(14, 2)
  status         SaleStatus    @default(COMPLETED)
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  cashier        User          @relation(fields: [cashier_id], references: [id])
  sale_items     SaleItem[]
  @@index([created_at], map: "idx_sales_date")
  @@index([status], map: "idx_sales_status")
  @@map("sales")
}

model SaleItem {
  id            BigInt      @id @default(autoincrement()) @db.BigInt
  sale_id       BigInt   @db.BigInt
  product_id    BigInt   @db.BigInt
  product_name  String   @db.VarChar(160)
  sku           String   @db.VarChar(70)
  quantity_sold Int
  unit_price    Decimal  @db.Decimal(14, 2)
  unit_cost     Decimal  @default(0) @db.Decimal(14, 2)
  subtotal      Decimal  @db.Decimal(14, 2)
  sale          Sale     @relation(fields: [sale_id], references: [id])
  product       Product  @relation(fields: [product_id], references: [id])
  @@index([product_id], map: "idx_sale_item_product")
  @@map("sale_items")
}

model StockMovement {
  id                BigInt       @id @default(autoincrement()) @db.BigInt
  product_id        BigInt       @db.BigInt
  movement_type     MovementType
  quantity_change   Int
  previous_quantity Int
  new_quantity      Int
  reference_type    String?      @db.VarChar(40)
  reference_id      BigInt?      @db.BigInt
  note              String?      @db.VarChar(255)
  performed_by      BigInt       @db.BigInt
  created_at        DateTime     @default(now()) @db.Timestamp(0)
  product           Product      @relation(fields: [product_id], references: [id])
  performer         User         @relation(fields: [performed_by], references: [id])
  @@index([product_id, created_at], map: "idx_movement_product_date")
  @@index([created_at], map: "idx_movement_date")
  @@map("stock_movements")
}

model Notification {
  id                BigInt                 @id @default(autoincrement()) @db.BigInt
  recipient_id      BigInt?                @db.BigInt
  product_id        BigInt?                @db.BigInt
  notification_type NotificationType
  priority          NotificationPriority @default(INFO)
  title             String              @db.VarChar(160)
  message           String              @db.VarChar(500)
  metadata          Json?
  is_read           Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  recipient         User?               @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  product           Product?            @relation(fields: [product_id], references: [id], onDelete: SetNull)
  @@index([recipient_id, is_read, created_at], map: "idx_notification_recipient")
  @@map("notifications")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  user_id     BigInt?   @db.BigInt
  action      String    @db.VarChar(100)
  entity_type String    @db.VarChar(80)
  entity_id   BigInt?   @db.BigInt
  before_data Json?
  after_data  Json?
  ip_address  String?   @db.VarChar(48)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  user        User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  @@index([created_at], map: "idx_audit_date")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@map("audit_logs")
}

