{
    "name":  "nourish-hub-store-management",
    "version":  "2.0.0",
    "private":  true,
    "description":  "NOURISH HUB professional inventory, POS and store operations platform powered by Prisma ORM",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "start":  "node src/server.js",
                    "dev":  "node --watch src/server.js",
                    "db:generate":  "prisma generate",
                    "db:init":  "prisma migrate deploy",
                    "db:migrate":  "prisma migrate dev",
                    "db:push":  "prisma db push",
                    "db:seed":  "node src/seed.js",
                    "postinstall":  "prisma generate"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.0",
                         "bcryptjs":  "^2.4.3",
                         "compression":  "^1.7.4",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^5.1.0",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.2",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "prisma":  "^6.19.0"
                        }
}
